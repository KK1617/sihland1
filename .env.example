# ==============================================================================
# SIH-Land / GeoAI Studio - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for GeoAgent AI conversational assistant)
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime environment (production for deployed Render service, development for local)
NODE_ENV=production

# Server Port (Render sets this automatically, default is 3000 locally or 10000 on Render)
PORT=3000

# Public application base URL (e.g. https://your-service.onrender.com)
APP_URL=http://localhost:3000
